  "SHOW/DX": {
    "category": "DX spots",
    "summary": "Search the spot database by band, frequency, callsign, age, spotter, country, zone, state, origin, IP address and other selectors.",
    "why": "SHOW/DX is much more than \u201cshow the last spots\u201d: its selectors can be combined to answer very specific questions.",
    "examples": [
      [
        "Last spots",
        "SHOW/DX"
      ],
      [
        "20 m spots mentioning IOTA",
        "SHOW/DX ON 20M INFO IOTA"
      ],
      [
        "VHF spots for calls beginning with 9A from the last 30 days",
        "SHOW/DX 9A ON VHF DAY 30"
      ],
      [
        "Exact callsign only",
        "SHOW/DX HB2008G EXACT"
      ],
      [
        "Spots for CQ zones 4, 5 and 6",
        "SHOW/DX ZONE 4,5,6"
      ],
      [
        "Spots made by stations in CQ zones 4, 5 and 6",
        "SHOW/DX BY_ZONE 4,5,6"
      ],
      [
        "US states Indiana and Ohio",
        "SHOW/DX STATE IN,OH"
      ],
      [
        "Filter by origin node",
        "SHOW/DX ORIGIN GB7TLH-4"
      ],
      [
        "Filter by spotter IP",
        "SHOW/DX IP 82.65.128.4"
      ],
      [
        "IOTA search",
        "SHOW/DX IOTA EU-064"
      ],
      [
        "Locator search",
        "SHOW/DX QRA JN86"
      ],
      [
        "Country search",
        "SHOW/DX DXCC OQ2"
      ],
      [
        "Apply your personal spot filter",
        "SHOW/MYDX"
      ]
    ],
    "related": [
      "SHOW/MYDX",
      "SHOW/DXCC",
      "SHOW/FDX",
      "DX",
      "ACCEPT/SPOTS",
      "REJECT/SPOTS"
    ]
  },
