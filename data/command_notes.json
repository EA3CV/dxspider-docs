  "SET/HERE": {
    "category": "Presence",
    "summary": "Tell DXSpider that you are present at your terminal.",
    "why": "Use this when you want your current session to advertise that you are actively present rather than away.",
    "examples": [
      [
        "Mark yourself present",
        "SET/HERE"
      ],
      [
        "Later, mark yourself away",
        "UNSET/HERE"
      ]
    ],
    "related": [
      "UNSET/HERE",
      "SHOW/CONFIGURATION"
    ]
  },
  "UNSET/HERE": {
    "category": "Presence",
    "summary": "Tell DXSpider that you are absent from your terminal.",
    "why": "This is the opposite of SET/HERE. It marks your session as away without disconnecting you.",
    "examples": [
      [
        "Mark yourself away",
        "UNSET/HERE"
      ],
      [
        "Mark yourself present again",
        "SET/HERE"
      ]
    ],
    "related": [
      "SET/HERE",
      "SHOW/CONFIGURATION"
    ]
  },
  "SHOW/MYDX": {
    "category": "DX spots",
    "summary": "Search the spot database after applying your personal spot filter.",
    "why": "Use SHOW/MYDX when you want historical/query results to follow the same spot-selection rules you configured for incoming spots.",
    "examples": [
      [
        "Create an HF-only personal filter",
        "ACCEPT/SPOTS 1 ON HF"
      ],
      [
        "Query using that filter",
        "SHOW/MYDX"
      ],
      [
        "Add the normal SHOW/DX selectors",
        "SHOW/MYDX ON 20M INFO IOTA"
      ]
    ],
    "related": [
      "SHOW/DX",
      "ACCEPT/SPOTS",
      "REJECT/SPOTS",
      "CLEAR/SPOTS",
      "SHOW/FILTER"
    ]
  },
  "DISABLE/AUTOFTX": {
    "category": "DX spots",
    "summary": "Suppress FT4/FT8 spots whose comments look automatically generated, while retaining more useful human-entered FT4/FT8 spots.",
    "why": "Useful when you want FT4/FT8 activity but do not want repetitive machine-generated signal-report comments.",
    "examples": [
      [
        "Keep FT4/FT8 enabled but suppress autogenerated comments",
        "ENABLE/FTX\nDISABLE/AUTOFTX"
      ],
      [
        "Restore autogenerated FT4/FT8 spots",
        "ENABLE/AUTOFTX"
      ]
    ],
    "related": [
      "ENABLE/AUTOFTX",
      "DISABLE/FTX",
      "ENABLE/FTX"
    ]
  },
  "DISABLE/FTX": {
    "category": "DX spots",
    "summary": "Suppress all spots whose comment contains FT4 or FT8.",
    "why": "Use this only when you do not want FT4/FT8 spots at all. For a less aggressive option, keep FTX enabled and disable AUTOFTX instead.",
    "examples": [
      [
        "Block all FT4/FT8 spots",
        "DISABLE/FTX"
      ],
      [
        "Allow FT4/FT8 again",
        "ENABLE/FTX"
      ]
    ],
    "related": [
      "ENABLE/FTX",
      "DISABLE/AUTOFTX",
      "ENABLE/AUTOFTX"
    ]
  },
  "DIRECTORY": {
    "category": "Messages",
    "summary": "Browse DXSpider messages by ownership, age, sender, recipient, subject or message-number range.",
    "why": "DIRECTORY is the entry point to the message system. Its selectors can be combined instead of scrolling through an undifferentiated list.",
