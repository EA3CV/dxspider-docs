{
  "ACCEPT/SPOTS": {
    "category": "Filtering",
    "summary": "Allow only DX spots that match one or more filter rules.",
    "examples": [
      [
        "Accept CW spots on HF",
        "ACCEPT/SPOTS 1 ON HF/CW"
      ],
      [
        "Accept VHF spots from or for CQ zones 14\u201316",
        "ACCEPT/SPOTS 2 ON VHF AND (BY_ZONE 14,15,16 OR CALL_ZONE 14,15,16)"
      ],
      [
        "Accept spots reported by US states",
        "ACCEPT/SPOTS BY_STATE VA,NH,RI,MA,ME"
      ],
      [
        "Accept everything",
        "ACCEPT/SPOTS 3 ALL"
      ]
    ],
    "related": [
      "REJECT/SPOTS",
      "CLEAR/SPOTS",
      "SHOW/FILTER",
      "SHOW/BANDS"
    ]
  },
  "ACCEPT/RBN": {
    "category": "RBN / Filtering",
    "summary": "Apply an accept filter specifically to RBN/Skimmer spots.",
    "examples": [
      [
        "Accept HF CW RBN spots",
        "ACCEPT/RBN 1 ON HF/CW"
      ],
      [
        "Accept RBN spots for selected DXCCs",
        "ACCEPT/RBN 2 CALL_DXCC 230,291"
      ],
      [
        "Remove the RBN filter later",
        "CLEAR/RBN ALL"
      ]
    ],
    "related": [
      "REJECT/RBN",
      "CLEAR/RBN",
      "SET/WANTRBN",
      "SHOW/FILTER"
    ]
  },
  "REJECT/SPOTS": {
    "category": "Filtering",
    "summary": "Reject DX spots that match one or more filter rules.",
    "examples": [
      [
        "Reject a band",
        "REJECT/SPOTS 1 ON 160M"
      ],
      [
        "Reject selected origins",
        "REJECT/SPOTS 2 ORIGIN BADNODE1,BADNODE2"
      ]
    ],
    "related": [
      "ACCEPT/SPOTS",
      "CLEAR/SPOTS",
      "SHOW/FILTER"
    ]
  },
  "CLEAR/SPOTS": {
    "category": "Filtering",
    "summary": "Remove one line or the complete DX spot filter.",
    "examples": [
      [
        "Remove line 1",
        "CLEAR/SPOTS 1"
      ],
      [
        "Remove the complete filter",
        "CLEAR/SPOTS ALL"
      ]
    ],
    "related": [
      "ACCEPT/SPOTS",
      "REJECT/SPOTS",
      "SHOW/FILTER"
    ]
  },
  "SET/WANTRBN": {
    "category": "RBN",
    "summary": "Choose which curated RBN/Skimmer categories are delivered to the user.",
    "examples": [
      [
        "Enable the default RBN selection",
        "SET/WANTRBN"
      ],
      [
        "CW only",
        "SET/WANTRBN CW"
      ],
      [
        "Digital categories",
        "SET/WANTRBN PSK RTTY FT"
      ],
      [
        "Disable RBN delivery",
        "UNSET/WANTRBN"
      ]
    ],
    "related": [
      "UNSET/WANTRBN",
      "ACCEPT/RBN",
      "REJECT/RBN",
      "CLEAR/RBN"
    ]
  },
